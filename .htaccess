DirectoryIndex login.php

# 1. Halang akses ke fail sensitif (seperti .env)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Halang fail pembangunan dan dump database daripada dihidangkan oleh web server
<FilesMatch "\.(sql|ps1|bak|old|log)$">
    Require all denied
</FilesMatch>

# 2. Matikan paparan senarai folder (Directory browsing)
Options -Indexes


